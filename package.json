{
  "name": "@steerprotocol/eas-store",
  "version": "0.1.3",
  "description": "Attestation-backed key-value store built on Ethereum Attestation Service.",
  "homepage": "https://github.com/SteerProtocol/eas-store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteerProtocol/eas-store.git"
  },
  "bugs": {
    "url": "https://github.com/SteerProtocol/eas-store/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "workspaces": [
    "examples/*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "demo:build": "npm --workspace eas-store-vite-demo run build",
    "demo:dev": "npm --workspace eas-store-vite-demo run dev --",
    "demo:e2e": "npm --workspace eas-store-vite-demo run test:e2e",
    "demo:preview": "npm --workspace eas-store-vite-demo run preview --",
    "demo:typecheck": "npm --workspace eas-store-vite-demo run typecheck",
    "release": "semantic-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "attestations",
    "database",
    "eas",
    "ethereum",
    "key-value-store",
    "storage"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^2.9.0",
    "@scure/bip39": "^2.2.0",
    "ethers": "^6.16.0"
  },
  "overrides": {
    "hardhat": "3.4.5",
    "npm": "11.14.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
