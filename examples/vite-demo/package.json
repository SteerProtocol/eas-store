{
  "name": "eas-store-vite-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../.. run build",
    "dev": "vite",
    "prebuild": "npm --prefix ../.. run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm --prefix ../.. run build",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "rm -rf .nyc_output coverage && E2E_PORT=4175 E2E_COVERAGE=true VITE_COVERAGE=true playwright test && nyc report --reporter=text --reporter=lcov --exclude src/App.tsx --check-coverage --lines=90 --functions=90 --statements=90 --branches=75",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@steerprotocol/eas-store": "file:../..",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.16.0",
    "lucide-react": "^1.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "nyc": "^18.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "vite-plugin-istanbul": "^8.0.0"
  }
}
